# Defina um destino antes de divulgar o site ou iniciar campanhas.
# O endpoint deve aceitar POST JSON, responder com HTTP 2xx apenas quando o lead for salvo,
# permitir a origem pública do site via CORS e proteger o envio contra spam.
REACT_APP_LEAD_ENDPOINT=

# Alternativa ao endpoint: número comercial com código do país, sem espaços.
# Exemplo de formato: 5511999999999. Não use o número de exemplo em produção.
REACT_APP_CONTACT_WHATSAPP=
